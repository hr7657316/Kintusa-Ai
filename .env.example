# Copy to .env for local development. Every value is read by kintsua.core.config.Settings.
ENV=dev
BASE_URL=http://localhost:8000
DATABASE_URL=postgresql+psycopg://postgres:dev@localhost:5432/kintsua
DATA_DIR=.kintsua-data

# LLM: anthropic | openai | fake
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_CLASSIFIER_MODEL=claude-opus-5-5
LLM_FIXER_MODEL=claude-opus-5-5

# GitHub App (create it in one click at $BASE_URL/setup/github)
GITHUB_APP_ID=
GITHUB_APP_SLUG=kintsua
GITHUB_APP_PRIVATE_KEY=            # PEM text or a path to the .pem file
GITHUB_WEBHOOK_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# signs the session cookie; prod refuses to start unless this is a random value of 32+ chars
SESSION_SECRET=change-me

# Snapshots over 256 KB go to S3-compatible storage; unset = local DATA_DIR.
# Prod refuses local files unless every process shares DATA_DIR (one host / one volume):
DATA_DIR_SHARED=false
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Worker: a job whose worker died is handed out again after JOB_LEASE_S; on SIGTERM the
# running job gets WORKER_SHUTDOWN_GRACE_S to finish (keep it below the platform kill timeout)
JOB_LEASE_S=900
WORKER_SHUTDOWN_GRACE_S=3
# Refuse localhost / private / metadata addresses for customer-supplied URLs (keep on)
NET_GUARD=true
# Watchers: per-request HTTP timeout, whole-poll budget, first backoff step after a failure
POLL_HTTP_TIMEOUT_S=60
POLL_TIMEOUT_S=600
SOURCE_BACKOFF_BASE_S=900

# Fixer sandbox: docker | local
SANDBOX_BACKEND=docker
SANDBOX_IMAGE=kintsua-sandbox:latest
FIX_CONCURRENCY=3

# Issues open automatically only when this is true (or per org in settings)
AUTO_ISSUE=false

# Billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
