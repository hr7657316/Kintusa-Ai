{
  "name": "mcp_get_weather_units_required",
  "description": "The weather MCP server added a required `units` input to get_weather. The schema's enum and default make `metric` inferable, so the agent adds it to the one call site and the synthetic call validates against the new inputSchema.",
  "source": {
    "kind": "mcp",
    "locator": "https://mcp.weather.example/mcp",
    "display_name": "Weather MCP",
    "vendor": "weather"
  },
  "event": {
    "source_kind": "mcp",
    "from_version": "1.4.0",
    "to_version": "1.5.0",
    "ops": [
      {
        "op": "required_added",
        "path": "/tools/get_weather/inputSchema/required",
        "before": ["city"],
        "after": ["city", "units"]
      },
      {
        "op": "added",
        "path": "/tools/get_weather/inputSchema/properties/units",
        "before": null,
        "after": {"type": "string", "enum": ["metric", "imperial"], "default": "metric", "description": "Temperature units; older clients behaved as metric"}
      }
    ],
    "text": null
  },
  "classification": {
    "severity": "breaking",
    "category": "required_param",
    "summary": "MCP tool get_weather now requires the `units` input",
    "affected_paths": ["tool:get_weather"],
    "migration_hint": "Pass units='metric' (the previous implicit behaviour) or 'imperial' in every get_weather call.",
    "rule_hits": ["required_added"]
  },
  "dependency": {"kind": "mcp", "name": "https://mcp.weather.example/mcp", "meta": {"vendor": "weather", "config_file": ".mcp.json"}},
  "tool_name": "get_weather",
  "new_input_schema": {
    "type": "object",
    "properties": {
      "city": {"type": "string", "description": "City name"},
      "units": {"type": "string", "enum": ["metric", "imperial"], "default": "metric", "description": "Temperature units; older clients behaved as metric"}
    },
    "required": ["city", "units"],
    "additionalProperties": false
  },
  "to_snapshot_body": {
    "server": {"name": "weather", "version": "1.5.0", "protocolVersion": "2025-06-18", "capabilities": {"tools": {}}},
    "tools": {
      "get_weather": {
        "description": "Current weather for a city",
        "inputSchema": {
          "type": "object",
          "properties": {
            "city": {"type": "string", "description": "City name"},
            "units": {"type": "string", "enum": ["metric", "imperial"], "default": "metric", "description": "Temperature units; older clients behaved as metric"}
          },
          "required": ["city", "units"],
          "additionalProperties": false
        }
      }
    },
    "resources": {},
    "resourceTemplates": {},
    "prompts": {}
  },
  "call_sites": [
    {
      "file_path": "agent/weather.py",
      "line": 14,
      "symbol": "client.call_tool",
      "operation": "get_weather",
      "args_shape": {"keys": ["city"]}
    }
  ],
  "patch": [
    {
      "path": "agent/weather.py",
      "old": "    result = client.call_tool(\"get_weather\", {\"city\": city})\n",
      "new": "    result = client.call_tool(\"get_weather\", {\"city\": city, \"units\": \"metric\"})\n"
    }
  ],
  "agent_reason": "Added the now-required `units` input with 'metric', the schema default and the previous implicit behaviour.",
